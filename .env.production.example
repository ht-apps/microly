APP_ENV=production
APP_VERSION=1.0.0
MICROLY_IMAGE_TAG=1.0.0
MICROLY_OPERATIONS_IMAGE_TAG=1.0.0
API_PORT=3000
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
API_PUBLIC_ORIGIN=https://api.example.com
ADMIN_PUBLIC_ORIGIN=https://admin.example.com
TARO_APP_API_BASE_URL=https://api.example.com
TARO_APP_VERSION=1.0.0
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgresql://microly:replace-with-a-strong-random-password@postgres:5432/microly
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=replace-with-wechat-secret
IDENTITY_HASH_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
ADMIN_ORIGINS=https://admin.example.com
DEEPSEEK_API_KEY=
AI_INPUT_HASH_SECRET=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=30
BACKUP_DIR=/backups
BACKUP_HOST_DIR=./backups-production
BACKUP_INTERVAL_HOURS=24
