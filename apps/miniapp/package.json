{
  "name": "@microly/miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "微习微信小程序与 H5 客户端",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "pnpm run build:weapp -- --watch",
    "dev:h5": "pnpm run build:h5 -- --watch",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.mjs",
    "lint:styles": "stylelint 'src/**/*.scss'"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@microly/content-schema": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-generator": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/minimatch": "^5.1.2",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.1",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.21",
    "react-refresh": "^0.14.2",
    "sass": "^1.101.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  }
}
