{
  "name": "microly",
  "version": "1.0.0",
  "private": true,
  "description": "一款面向碎片时间的 AI 微学习应用",
  "author": "jianghaotian",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build:packages": "pnpm --filter @microly/content-schema build && pnpm --filter @microly/training-content build && pnpm --filter @microly/api-contract build",
    "dev:miniapp": "pnpm build:packages && pnpm --filter @microly/miniapp dev:weapp",
    "dev:api": "pnpm build:packages && DATABASE_URL=postgresql://microly:microly@localhost:5432/microly API_PORT=3000 pnpm --filter @microly/api dev",
    "dev:admin": "pnpm build:packages && pnpm --filter @microly/admin dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "DATABASE_URL=postgresql://microly:microly@localhost:5432/microly pnpm --filter @microly/api db:migrate",
    "db:seed": "DATABASE_URL=postgresql://microly:microly@localhost:5432/microly pnpm --filter @microly/api db:seed",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "test:integration:api": "DATABASE_URL=postgresql://microly:microly@localhost:5433/microly_test pnpm --filter @microly/api test:integration",
    "build:miniapp": "pnpm build:packages && pnpm --filter @microly/miniapp build:weapp",
    "build:api": "pnpm build:packages && pnpm --filter @microly/api build",
    "build:admin": "pnpm build:packages && pnpm --filter @microly/admin build",
    "test": "pnpm build:packages && pnpm --recursive --if-present test",
    "typecheck": "pnpm build:packages && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7"
  }
}
