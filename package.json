{
  "name": "microly",
  "version": "1.0.0",
  "private": true,
  "description": "一款面向碎片时间的 AI 微学习小程序",
  "author": "jianghaotian",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-generator": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/minimatch": "^5.1.2",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.1",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.21",
    "react-refresh": "^0.14.2",
    "sass": "^1.101.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14"
