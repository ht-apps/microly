{
  "name": "microly",
  "version": "1.0.0",
  "private": true,
  "description": "一款面向碎片时间的 AI 微学习应用",
  "author": "jianghaotian",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev:miniapp": "pnpm --filter @microly/miniapp dev:weapp",
    "dev:api": "pnpm --filter @microly/api dev",
    "dev:admin": "pnpm --filter @microly/admin dev",
    "build:miniapp": "pnpm --filter @microly/miniapp build:weapp",
    "build:api": "pnpm --filter @microly/api build",
    "build:admin": "pnpm --filter @microly/admin build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7"
  }
}
